{
  "name": "creole-llm",
  "version": "1.0.0",
  "description": "Training-free context compaction for coding agents: Creole, a compact working language for notes, plans and replies, plus compaction of long sessions into a small session graph of the task, the user's constraints and the current work.",
  "license": "MIT",
  "author": "Chew Zhan Hong",
  "homepage": "https://github.com/gluppler/Creole-LLM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluppler/Creole-LLM.git"
  },
  "bugs": "https://github.com/gluppler/Creole-LLM/issues",
  "type": "module",
  "main": "./.opencode/plugins/creole.mjs",
  "keywords": [
    "pi-package",
    "claude-code",
    "codex",
    "opencode",
    "agent",
    "context",
    "compaction",
    "tokens"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    ".agents/",
    ".claude-plugin/marketplace.json",
    ".claude-plugin/plugin.json",
    ".clinerules/",
    ".codex-plugin/",
    ".cursor/",
    ".cursor-plugin/",
    ".devin-plugin/",
    ".github/copilot-instructions.md",
    ".github/plugin/",
    ".grok-plugin/",
    ".kimi-plugin/",
    ".kiro/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    ".windsurf/",
    "AGENTS.md",
    "INSTALL.md",
    "extensions/",
    "hooks/",
    "lib/",
    "plugin.json",
    "scripts/sync-rules.mjs",
    "skills/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "omp": {
    "extensions": [
      "./extensions/creole.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/creole.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
